# Cookie session encryption (iron-session). Required in production — must be
# at least 32 characters. Generate one with: openssl rand -base64 32
SESSION_SECRET=

# --- Zepto MCP -----------------------------------------------------------
# Self-serve, no approval needed for dev (see PRD Appendix B). You still need
# your OWN registered OAuth client for FreshPlate — do not reuse client_id /
# redirect_uri values from any other app's MCP config (e.g. Claude Code's own
# dev session config); those are registered to a different redirect_uri and
# won't work here anyway.
ZEPTO_MCP_URL=https://mcp.zepto.co.in/mcp
ZEPTO_OAUTH_AUTHORIZE_URL=
ZEPTO_OAUTH_TOKEN_URL=
ZEPTO_CLIENT_ID=
ZEPTO_CLIENT_SECRET=
ZEPTO_REDIRECT_URI=http://localhost:3000/api/auth/zepto/callback
ZEPTO_OAUTH_SCOPE=tools:read tools:write

# --- Swiggy Instamart MCP -------------------------------------------------
# Swiggy does not issue client credentials: FreshPlate registers itself with
# Dynamic Client Registration (RFC 7591) each time someone connects, and finds
# the sign-in endpoints from https://mcp.swiggy.com/.well-known/oauth-authorization-server.
# So the only thing you must set is the redirect URI. It is matched exactly:
#   - development: http://localhost:3000/api/auth/instamart/callback works as is
#   - production: must be HTTPS and approved by Swiggy during access review
#     (apply at https://mcp.swiggy.com/builders/access/, or email builders@swiggy.in)
INSTAMART_MCP_URL=https://mcp.swiggy.com/im
INSTAMART_REDIRECT_URI=http://localhost:3000/api/auth/instamart/callback
# Optional: defaults to mcp:tools
INSTAMART_OAUTH_SCOPE=
# Optional, only to use a fixed pre-registered client instead of registering one.
# Setting INSTAMART_CLIENT_ID turns automatic registration off.
INSTAMART_CLIENT_ID=
INSTAMART_CLIENT_SECRET=
INSTAMART_OAUTH_AUTHORIZE_URL=
INSTAMART_OAUTH_TOKEN_URL=

# Note: Zepto still needs a client_id/secret and authorize+token URLs from Zepto;
# code correctness alone doesn't unblock that.
