# Cookie session encryption (iron-session). Required in production — must be
# at least 32 characters. Generate one with: openssl rand -base64 32
SESSION_SECRET=

# --- Zepto MCP -----------------------------------------------------------
# Self-serve, no approval needed for dev (see PRD Appendix B). You still need
# your OWN registered OAuth client for FreshPlate — do not reuse client_id /
# redirect_uri values from any other app's MCP config (e.g. Claude Code's own
# dev session config); those are registered to a different redirect_uri and
# won't work here anyway.
ZEPTO_MCP_URL=https://mcp.zepto.co.in/mcp
ZEPTO_OAUTH_AUTHORIZE_URL=
ZEPTO_OAUTH_TOKEN_URL=
ZEPTO_CLIENT_ID=
ZEPTO_CLIENT_SECRET=
ZEPTO_REDIRECT_URI=http://localhost:3000/api/auth/zepto/callback
ZEPTO_OAUTH_SCOPE=tools:read tools:write

# --- Swiggy Instamart MCP -------------------------------------------------
# Dev: no approval needed. Production: email builders@swiggy.in with a working
# demo to get real credentials (see PRD §9.2, §16).
INSTAMART_MCP_URL=https://mcp.swiggy.com/im
INSTAMART_OAUTH_AUTHORIZE_URL=
INSTAMART_OAUTH_TOKEN_URL=
INSTAMART_CLIENT_ID=
INSTAMART_CLIENT_SECRET=
INSTAMART_REDIRECT_URI=http://localhost:3000/api/auth/instamart/callback
INSTAMART_OAUTH_SCOPE=

# Note: end-to-end OAuth testing is blocked until real client_id/secret/
# authorize+token URLs are obtained from each platform — code correctness
# alone doesn't unblock this.
